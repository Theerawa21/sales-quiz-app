function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('ระบบทดสอบออนไลน์')
    .addItem('ตั้งค่าระบบ / โหลดข้อสอบใหม่ (Setup)', 'setupSpreadsheet')
    .addItem('ล้างคะแนนทั้งหมด', 'clearResponses')
    .addToUi();
}

function setupSpreadsheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  setupQuestionsSheet_(ss);
  setupStudentsSheet_(ss);
  setupResponsesSheet_(ss);
  setupSummarySheet_(ss);
  SpreadsheetApp.getUi().alert(
    'ตั้งค่าระบบเรียบร้อยแล้ว!\n\n' +
    'ระบบป้องกันการทุจริตที่เปิดใช้งาน:\n' +
    '- สุ่มลำดับข้อ + ลำดับตัวเลือก (ก/ข/ค/ง) ไม่ซ้ำกันในแต่ละคน\n' +
    '- จำกัดเวลาทำข้อสอบ ' + EXAM_DURATION_MIN + ' นาที (ระบบจับเวลาฝั่งเซิร์ฟเวอร์ ส่งคำตอบอัตโนมัติเมื่อหมดเวลา)\n' +
    '- ทำได้คนละ 1 ครั้งเท่านั้น (ตรวจจากรหัสประจำตัวนักเรียน)\n' +
    '- นับจำนวนครั้งที่สลับหน้าจอ/ออกจากแท็บระหว่างสอบ และบันทึกไว้ให้ครูตรวจสอบ\n' +
    '- ปิดการคัดลอก/วาง/คลิกขวาในหน้าโจทย์\n\n' +
    'ขั้นต่อไป: ไปที่เมนู Deploy > New deployment > เลือกประเภท "Web app" ' +
    'ตั้งค่า Execute as: Me, Who has access: Anyone with the link แล้วกด Deploy เพื่อรับลิงก์แบบทดสอบ'
  );
}

function setupQuestionsSheet_(ss) {
  var sh = ss.getSheetByName(SHEET_QUESTIONS);
  if (sh) { ss.deleteSheet(sh); }
  sh = ss.insertSheet(SHEET_QUESTIONS);
  var header = ['ชุดที่', 'ข้อที่', 'คำถาม', 'ตัวเลือก ก', 'ตัวเลือก ข', 'ตัวเลือก ค', 'ตัวเลือก ง', 'เฉลย (0=ก,1=ข,2=ค,3=ง)'];
  var rows = [header];
  for (var s = 1; s <= TOTAL_SETS; s++) {
    SEED_DATA[s].forEach(function (q) {
      rows.push([s, q.no, q.question, q.choices[0], q.choices[1], q.choices[2], q.choices[3], q.answerIndex]);
    });
  }
  sh.getRange(1, 1, rows.length, header.length).setValues(rows);
  sh.setFrozenRows(1);
  sh.getRange(1, 1, 1, header.length).setFontWeight('bold').setBackground('#4a86e8').setFontColor('#ffffff');
  sh.autoResizeColumns(1, header.length);
}

function setupStudentsSheet_(ss) {
  var sh = ss.getSheetByName(SHEET_STUDENTS);
  if (sh) { ss.deleteSheet(sh); }
  sh = ss.insertSheet(SHEET_STUDENTS);
  var header = ['เลขที่', 'รหัสประจำตัวนักเรียน', 'ชื่อ-นามสกุล', 'ชั้น'];
  var rows = [header];
  ROSTER_DATA.forEach(function (s) {
    rows.push([s.seatNo, s.studentId, s.fullName, s.className]);
  });
  sh.getRange(2, 2, Math.max(rows.length - 1, 1), 1).setNumberFormat('@'); // เก็บรหัสนักเรียนเป็นข้อความ กันเลขนำหน้า 0 หาย
  sh.getRange(1, 1, rows.length, header.length).setValues(rows);
  sh.setFrozenRows(1);
  sh.getRange(1, 1, 1, header.length).setFontWeight('bold').setBackground('#e69138').setFontColor('#ffffff');
  sh.autoResizeColumns(1, header.length);
}

