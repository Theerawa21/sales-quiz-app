function clearResponses() {
  var ui = SpreadsheetApp.getUi();
  var resp = ui.alert('ยืนยันการล้างคะแนน', 'ต้องการลบข้อมูลคะแนนที่บันทึกไว้ทั้งหมดใช่หรือไม่?', ui.ButtonSet.YES_NO);
  if (resp !== ui.Button.YES) return;
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_RESPONSES);
  if (sh && sh.getLastRow() > 1) {
    sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).clearContent();
  }
}

function doGet(e) {
  // รองรับ 2 โหมด:
  // 1) เปิด URL เฉยๆ (ไม่มี ?action=...) -> แสดงหน้าเว็บ Index.html ตามปกติ (ใช้ google.script.run)
  // 2) มี ?action=... -> ทำงานเป็น JSON API สำหรับหน้าเว็บภายนอก เช่นที่ฝากไว้บน GitHub Pages (ใช้ fetch())
  if (e && e.parameter && e.parameter.action) {
    return jsonOutput_(safeDispatch_(e.parameter.action, e.parameter));
  }
  return HtmlService.createTemplateFromFile('Index')
    .evaluate()
    .setTitle('แบบทดสอบออนไลน์ วิชาการขาย')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// รับคำขอแบบ POST เป็น JSON API สำหรับหน้าเว็บภายนอก (เช่น GitHub Pages) ที่เรียกด้วย fetch()
// ฝั่งไคลเอนต์ต้องส่ง body เป็น {"action": "...", "payload": {...}} และตั้ง Content-Type เป็น
// text/plain;charset=utf-8 (ไม่ใช่ application/json) เพื่อเลี่ยง CORS preflight ที่ Apps Script ไม่รองรับ
function doPost(e) {
  var body = {};
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return jsonOutput_({ ok: false, error: 'รูปแบบข้อมูลที่ส่งมาไม่ถูกต้อง (ต้องเป็น JSON)' });
  }
  return jsonOutput_(safeDispatch_(body.action, body.payload || {}));
}

function jsonOutput_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function safeDispatch_(action, payload) {
  try {
    var data = apiDispatch_(action, payload || {});
    return { ok: true, data: data };
  } catch (err) {
    return { ok: false, error: (err && err.message) ? err.message : String(err) };
  }
}

function apiDispatch_(action, payload) {
  switch (action) {
    case 'lookupStudent':
      return lookupStudent(payload.studentId);
    case 'startQuiz':
      return startQuiz(payload.studentId);
    case 'submitQuiz':
      return submitQuiz(payload);
    default:
      throw new Error('ไม่รู้จักคำสั่ง: ' + action);
  }
}

function getQuestionsSheetData_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_QUESTIONS);
  if (!sh || sh.getLastRow() < 2) {
    throw new Error('ไม่พบข้อมูลข้อสอบ กรุณากดเมนู "ระบบทดสอบออนไลน์ > ตั้งค่าระบบ" ก่อน');
  }
  var values = sh.getRange(2, 1, sh.getLastRow() - 1, 8).getValues();
  return values; // [setNo, qNo, question, a, b, c, d, answerIndex]
}

// สลับลำดับสมาชิกในอาร์เรย์แบบสุ่ม (Fisher-Yates) ใช้ป้องกันการทุจริต:
// ทำให้ทุกคนได้ลำดับข้อและลำดับตัวเลือกไม่เหมือนกันเลย ต่อให้เริ่มสอบพร้อมกัน
function shuffleArray_(arr) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
  }
  return a;
}

function getStudentsSheetData_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_STUDENTS);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 4).getValues(); // [seatNo, studentId, fullName, className]
}

// ค้นหานักเรียนจากรหัสประจำตัว เพื่อดึงชื่อ-นามสกุล/ชั้น/เลขที่ ขึ้นมาอัตโนมัติในหน้ากรอกข้อมูล
function lookupStudent(studentId) {
  var query = String(studentId || '').trim();
  if (!query) return { found: false };
  var rows = getStudentsSheetData_();
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][1]).trim() === query) {
      return {
        found: true,
        studentId: String(rows[i][1]).trim(),
        seatNo: rows[i][0],
        fullName: rows[i][2],
        className: rows[i][3]
      };
    }
  }
  return { found: false };
}

// ค้นหาว่ารหัสประจำตัวนักเรียนนี้เคยส่งคำตอบไปแล้วหรือยัง (จำกัดให้ทำได้คนละ 1 ครั้ง กันการสอบซ้ำเพื่อดูเฉลย)
function findAttempt_(studentId) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_RESPONSES);
  if (!sh || sh.getLastRow() < 2) return null;
  var query = String(studentId || '').trim();
  if (!query) return null;
  var values = sh.getRange(2, 1, sh.getLastRow() - 1, 13).getValues();
  for (var i = 0; i < values.length; i++) {
    if (String(values[i][1]).trim() === query) {
      return {
        submittedAt: values[i][0],
        score: values[i][6],
        total: values[i][7],
        percent: values[i][8]
      };
    }
  }
  return null;
}

// ข้อสอบทั้ง 5 ชุดในเอกสารต้นฉบับมีเนื้อหาเดียวกันทุกข้อ (สลับแค่ลำดับไว้ล่วงหน้าไว้สำหรับพิมพ์กระดาษ)
// ระบบออนไลน์จึงใช้ชุดที่ 1 เป็น "คลังข้อสอบต้นแบบ" แล้วสุ่มลำดับข้อ + สุ่มลำดับตัวเลือกใหม่ให้ผู้สอบทุกคนแบบเฉพาะบุคคล
// จำกัดเวลาสอบ: บันทึกเวลาเริ่มไว้ฝั่งเซิร์ฟเวอร์ (CacheService) เพื่อคำนวณเวลาที่ใช้จริงตอนส่งคำตอบ
// ไม่พึ่งเวลาที่ส่งมาจากเบราว์เซอร์อย่างเดียว ป้องกันการปรับเวลาในนาฬิกาฝั่งลูกข่าย
function startQuiz(studentId) {
  var student = lookupStudent(studentId);
  if (!student.found) {
    throw new Error('ไม่พบรหัสประจำตัวนักเรียนนี้ในระบบ');
  }

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var existing = findAttempt_(student.studentId);
    if (existing) {
      return {
        alreadyTaken: true,
        score: existing.score,
        total: existing.total,
        percent: existing.percent,
        submittedAt: existing.submittedAt
      };
    }

    var all = getQuestionsSheetData_();
    var bank = all.filter(function (r) { return Number(r[0]) === 1; });
    var shuffledBank = shuffleArray_(bank);

    var questions = shuffledBank.map(function (r) {
      return {
        origNo: Number(r[1]),
        question: r[2],
        choices: shuffleArray_([r[3], r[4], r[5], r[6]])
      };
    });

    var examCode = Utilities.getUuid().replace(/-/g, '').substring(0, 8).toUpperCase();

    CacheService.getScriptCache().put(
      'startTs_' + student.studentId,
      String(Date.now()),
      (EXAM_DURATION_MIN + 15) * 60
    );

    return {
      examCode: examCode,
      questions: questions,
      durationSec: EXAM_DURATION_MIN * 60
    };
  } finally {
    lock.releaseLock();
  }
}

function submitQuiz(payload) {
  var student = lookupStudent(payload.studentId);
  var studentName = student.found ? student.fullName : payload.name;
  var studentClass = student.found ? student.className : payload.className;
  var studentSeatNo = student.found ? student.seatNo : payload.number;
  var studentIdForLog = student.found ? student.studentId : String(payload.studentId || '').trim();

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var existing = findAttempt_(studentIdForLog);
    if (existing) {
      // ป้องกันการส่งซ้ำ (เช่น กดส่งสองครั้ง หรือเน็ตหลุดแล้ว retry) ไม่ให้บันทึกซ้อน
      return {
        score: existing.score,
        total: existing.total,
        percent: existing.percent,
        detail: [],
        alreadySubmitted: true
      };
    }
    return doSubmitQuiz_(payload, studentName, studentClass, studentSeatNo, studentIdForLog);
  } finally {
    lock.releaseLock();
  }
}

function doSubmitQuiz_(payload, studentName, studentClass, studentSeatNo, studentIdForLog) {
  var all = getQuestionsSheetData_();
  var bank = all.filter(function (r) { return Number(r[0]) === 1; });
  var score = 0;
  var total = bank.length;
  var detail = [];

  bank.forEach(function (r) {
    var origNo = Number(r[1]);
    var choices = [r[3], r[4], r[5], r[6]];
    var correctText = choices[Number(r[7])];
    var chosenText = payload.answers && payload.answers.hasOwnProperty(origNo) ? payload.answers[origNo] : null;
    var isCorrect = chosenText !== null && chosenText === correctText;
    if (isCorrect) score++;
    detail.push({
      no: origNo,
      question: r[2],
      correctText: correctText,
      chosenText: chosenText,
      isCorrect: isCorrect
    });
  });

  detail.sort(function (a, b) { return a.no - b.no; });

  var percent = total ? Math.round((score / total) * 10000) / 100 : 0;

  // คำนวณเวลาที่ใช้จริงจากเวลาที่บันทึกไว้ฝั่งเซิร์ฟเวอร์ตอน startQuiz (เชื่อถือได้กว่าเวลาที่ส่งมาจากเบราว์เซอร์)
  var cache = CacheService.getScriptCache();
  var cachedStartRaw = cache.get('startTs_' + studentIdForLog);
  var durationSec = payload.durationSec || 0;
  if (cachedStartRaw) {
    durationSec = Math.round((Date.now() - Number(cachedStartRaw)) / 1000);
    cache.remove('startTs_' + studentIdForLog);
  }
  var timeStatus = durationSec > (EXAM_DURATION_MIN * 60 + TIME_GRACE_SEC) ? 'เกินเวลา' : 'ปกติ';
  var tabSwitchCount = Number(payload.tabSwitchCount || 0);

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_RESPONSES);
  sh.appendRow([
    new Date(),
    studentIdForLog,
    studentName,
    studentClass,
    studentSeatNo,
    payload.examCode || '',
    score,
    total,
    percent,
    durationSec,
    tabSwitchCount,
    timeStatus,
    JSON.stringify(payload.answers)
  ]);

  return { score: score, total: total, percent: percent, detail: detail, timeStatus: timeStatus };
}
